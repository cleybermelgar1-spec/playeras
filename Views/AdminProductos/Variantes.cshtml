@model List<PlayerasJyC.Models.Variante>

@{
    var p = (Producto)ViewBag.Producto;
    ViewData["Title"] = "Tallas y stock";
}

<div class="page">
    <div class="toolbar">
        <h2>Tallas y stock: @p.Nombre</h2>
        <div class="acciones">
            <a asp-action="Imagenes" asp-route-id="@p.ProductoId" class="btn-sm">Imágenes</a>
            <a asp-action="Index" class="btn-sm gris">Volver a productos</a>
        </div>
    </div>

    <div class="tabla-wrap">
        <table class="tabla">
            <thead><tr><th>Talla</th><th>Color</th><th>SKU</th><th>Stock</th><th></th></tr></thead>
            <tbody>
            @foreach (var v in Model)
            {
                <tr>
                    <td>@v.Talla.Nombre</td>
                    <td><span class="swatch" style="background:@v.Color.CodigoHex"></span> @v.Color.Nombre</td>
                    <td>@v.Sku</td>
                    <td>
                        <form asp-action="ActualizarStock" asp-route-id="@v.VarianteId" method="post" class="acciones">
                            <input type="number" name="stock" value="@v.Stock" min="0" class="input-neon" style="width:90px" />
                            <button type="submit" class="btn-sm">Guardar</button>
                        </form>
                    </td>
                    <td>
                        <form asp-action="EliminarVariante" asp-route-id="@v.VarianteId" method="post" onsubmit="return confirm('¿Eliminar esta variante?');">
                            <button type="submit" class="btn-sm rojo">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (!Model.Any())
    {
        <p class="muted" style="margin-top:12px">Este producto aún no tiene tallas ni colores. Agrégalos abajo para poder venderlo.</p>
    }

    <form asp-action="AgregarVariante" method="post" class="form-card ancho" style="margin-top:18px">
        <h3 style="margin-top:0">Agregar talla y color</h3>
        <input type="hidden" name="productoId" value="@p.ProductoId" />
        <div class="form-row">
            <div class="form-group"><label>Talla</label><select name="tallaId" asp-items="(IEnumerable<SelectListItem>)ViewBag.Tallas"></select></div>
            <div class="form-group"><label>Color</label><select name="colorId" asp-items="(IEnumerable<SelectListItem>)ViewBag.Colores"></select></div>
            <div class="form-group"><label>Stock inicial</label><input type="number" name="stock" value="10" min="0" /></div>
            <div class="form-group"><label>SKU (opcional)</label><input type="text" name="sku" maxlength="40" /></div>
        </div>
        <button type="submit" class="btn-sm rosa">Agregar</button>
    </form>
</div>
