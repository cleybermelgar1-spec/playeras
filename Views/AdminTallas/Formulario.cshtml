@model PlayerasJyC.Models.Talla

@{
    bool esNuevo = Model.TallaId == 0;
    ViewData["Title"] = (esNuevo ? "Nuevo: " : "Editar: ") + "talla";
}

<div class="page">
    <h2>@(esNuevo ? "Nuevo" : "Editar") talla</h2>

    <form asp-action="@(esNuevo ? "Crear" : "Editar")" asp-route-id="@Model.TallaId" method="post" class="form-card">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-msg err">
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@e.ErrorMessage</div>
                }
            </div>
        }
        <input type="hidden" asp-for="TallaId" />
        <div class="form-group">
            <label>Talla (ej. M)</label>
            <input asp-for="Nombre" maxlength="10" placeholder="" />
        </div>
        <div class="form-group">
            <label>Orden en que aparece</label>
            <input asp-for="Orden" type="number" step="1" min="0" />
        </div>

        <div class="acciones" style="margin-top:14px">
            <button type="submit" class="btn-action">Guardar</button>
            <a asp-action="Index" class="btn-sm gris">Cancelar</a>
        </div>
    </form>
</div>
