@model PlayerasJyC.Models.Pedido

@{
    ViewData["Title"] = "Pedido " + Model.Folio;
}

<div class="page">
    <div class="toolbar">
        <h2>Pedido @Model.Folio <span class="estado @Model.EstadoPedido">@Model.EstadoPedido</span></h2>
        <div class="acciones">
            <a asp-action="Ticket" asp-route-id="@Model.PedidoId" class="btn-sm rosa">Ver ticket</a>
            <a asp-action="Index" class="btn-sm gris">Volver a pedidos</a>
        </div>
    </div>

    <p><b>Cliente:</b> @Model.Usuario.Nombre (@Model.Usuario.Email) · @Model.Usuario.Telefono</p>
    <p><b>Fecha:</b> @Model.FechaHora.ToString("dd/MM/yyyy HH:mm") · <b>Pago:</b> @Model.MetodoPago · <b>Envío:</b> @(Model.MetodoEnvio?.Nombre ?? "—")</p>
    <p><b>Enviar a:</b> @Model.NombreDestinatario — @Model.DireccionEnvio, @Model.Ciudad C.P. @Model.CodigoPostal @(string.IsNullOrWhiteSpace(Model.Telefono) ? "" : "· Tel. " + Model.Telefono)</p>

    <div class="tabla-wrap" style="margin-top:14px">
        <table class="tabla">
            <thead><tr><th></th><th>Producto</th><th>Talla / Color</th><th class="num">Cant.</th><th class="num">Precio</th><th class="num">Importe</th></tr></thead>
            <tbody>
            @foreach (var d in Model.Detalles)
            {
                <tr>
                    <td><img class="mini" src="@d.Producto.Imagen" alt="@d.NombreProducto" /></td>
                    <td>@d.NombreProducto</td>
                    <td>@d.Talla / @d.Color</td>
                    <td class="num">@d.Cantidad</td>
                    <td class="num">$@d.PrecioUnitario.ToString("N2")</td>
                    <td class="num">$@((d.Cantidad * d.PrecioUnitario).ToString("N2"))</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="resumen-box" style="max-width:360px;margin:16px 0 0 auto">
        <div class="linea"><span>Subtotal</span><span>$@Model.Subtotal.ToString("N2")</span></div>
        @if (Model.Descuento > 0)
        {
            <div class="linea"><span>Descuento @(Model.Cupon != null ? "(" + Model.Cupon.Codigo + ")" : "")</span><span>-$@Model.Descuento.ToString("N2")</span></div>
        }
        <div class="linea"><span>Envío</span><span>$@Model.CostosEnvio.ToString("N2")</span></div>
        <div class="linea total"><span>Total</span><span>$@Model.Total.ToString("N2")</span></div>
    </div>

    <h3>Pagos</h3>
    <div class="tabla-wrap">
        <table class="tabla">
            <thead><tr><th>Fecha</th><th>Método</th><th>Referencia</th><th class="num">Monto</th><th>Estado</th></tr></thead>
            <tbody>
            @foreach (var pg in Model.Pagos)
            {
                <tr>
                    <td>@pg.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@pg.MetodoPago</td>
                    <td>@pg.Referencia</td>
                    <td class="num">$@pg.Monto.ToString("N2")</td>
                    <td><span class="estado @pg.EstadoPago">@pg.EstadoPago</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (Model.EstadoPedido != "Cancelado")
    {
        <form asp-action="CambiarEstado" asp-route-id="@Model.PedidoId" method="post" class="form-card ancho" style="margin-top:20px">
            <h3 style="margin-top:0">Cambiar estado del pedido</h3>
            <div class="form-row">
                <div class="form-group">
                    <label>Nuevo estado</label>
                    <select name="estado">
                        @foreach (var e in Pedido.Estados)
                        {
                            <option value="@e" selected="@(e == Model.EstadoPedido)">@e</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Comentario (opcional)</label>
                    <input type="text" name="comentario" maxlength="250" placeholder="Ej. Guía de paquetería 12345" />
                </div>
            </div>
            <button type="submit" class="btn-sm rosa">Actualizar estado</button>
            <small class="muted" style="margin-left:8px">Al cancelar, las piezas regresan al inventario.</small>
        </form>
    }

    <h3>Historial</h3>
    @foreach (var h in Model.Historial.OrderBy(x => x.Fecha))
    {
        <div class="resena">
            <span class="estado @h.Estado">@h.Estado</span>
            <small>@h.Fecha.ToString("dd/MM/yyyy HH:mm") · @h.RealizadoPor</small>
            @if (!string.IsNullOrWhiteSpace(h.Comentario))
            {
                <p>@h.Comentario</p>
            }
        </div>
    }
</div>
