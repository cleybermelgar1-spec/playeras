@{
    var rol = Context.Session.GetString("Rol");
    var nombreSesion = Context.Session.GetString("Nombre");
    var carrito = Context.Session.GetInt32("CarritoCount") ?? 0;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Playeras Personalizadas JyC</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <a asp-controller="Home" asp-action="Index" class="logo">PLAYERAS <span>JyC</span></a>
        <nav>
            <a asp-controller="Home" asp-action="Index">Inicio</a>
            <a asp-controller="Home" asp-action="Index" asp-fragment="ofertas">Ofertas</a>
            <a asp-controller="Productos" asp-action="Index">Colección</a>
            <a asp-controller="Home" asp-action="Contacto">Contáctanos</a>
            @if (rol == "Cliente")
            {
                <a asp-controller="Carrito" asp-action="Index">Carrito@(carrito > 0 ? Html.Raw("<span class=\"cart-count\">" + carrito + "</span>") : null)</a>
                <a asp-controller="Pedidos" asp-action="Index">Mis pedidos</a>
                <a asp-controller="MiCuenta" asp-action="Index">@nombreSesion</a>
            }
            else if (rol == "Admin")
            {
                <a asp-controller="Admin" asp-action="Index">Panel admin</a>
            }
            else
            {
                <a asp-controller="Cuenta" asp-action="Ingresar">Ingresar</a>
                <a asp-controller="Cuenta" asp-action="Registro">Registrarse</a>
            }
            @if (rol != null)
            {
                <form asp-controller="Cuenta" asp-action="Salir" method="post">
                    <button type="submit" class="nav-btn">Salir</button>
                </form>
            }
        </nav>
    </header>

    @if (TempData["Mensaje"] != null || TempData["Error"] != null)
    {
        <div class="alert-wrap">
            @if (TempData["Mensaje"] != null)
            {
                <div class="alert-msg ok">@TempData["Mensaje"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert-msg err">@TempData["Error"]</div>
            }
        </div>
    }

    <main role="main">
        @RenderBody()
    </main>

    <footer>
        <p>&copy; 2026 PlayerasJyC — Streetwear & Custom Apparel</p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
