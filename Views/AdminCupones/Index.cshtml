@model IEnumerable<PlayerasJyC.Models.Cupon>

@{
    ViewData["Title"] = "Admin: Cupones de descuento";
}

<div class="page">
    <div class="toolbar">
        <h2>Cupones de descuento</h2>
        <div class="acciones">
            <a asp-action="Crear" class="btn-sm rosa">+ Nuevo</a>
            <a asp-controller="Admin" asp-action="Index" class="btn-sm gris">Volver al panel</a>
        </div>
    </div>

    <div class="tabla-wrap">
        <table class="tabla">
            <thead><tr><th>Código</th><th>Descuento</th><th>Mínimo</th><th>Vigencia</th><th>Usos</th><th>Activo</th><th></th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.Codigo</strong></td>
                    <td>@(item.Tipo == "Porcentaje" ? item.Valor.ToString("0.##") + "%" : "$" + item.Valor.ToString("N2"))</td>
                    <td>$@item.MinimoCompra.ToString("N2")</td>
                    <td>@item.FechaInicio.ToString("dd/MM/yyyy") - @item.FechaFin.ToString("dd/MM/yyyy")</td>
                    <td>@item.UsosActuales@(item.UsosMaximos.HasValue ? " / " + item.UsosMaximos.Value : "")</td>
                    <td>@(item.Activo ? "Sí" : "No")</td>
                    <td>
                        <div class="acciones">
                            <a asp-action="Editar" asp-route-id="@item.CuponId" class="btn-sm">Editar</a>
                            <form asp-action="Eliminar" asp-route-id="@item.CuponId" method="post" onsubmit="return confirm('¿Eliminar este registro?');">
                                <button type="submit" class="btn-sm rojo">Eliminar</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (!Model.Any())
    {
        <p class="muted" style="margin-top:12px">Aún no hay registros. Usa el botón "+ Nuevo".</p>
    }
</div>
