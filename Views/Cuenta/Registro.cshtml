@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="page">
    <h2>Crear cuenta</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert-msg err" style="margin-left:0">@ViewBag.Error</div>
    }

    <form asp-action="Registro" method="post" class="form-card" style="margin-top:16px">
        <div class="form-group">
            <label>Nombre completo</label>
            <input type="text" name="nombre" maxlength="100" value="@ViewBag.Nombre" required />
        </div>
        <div class="form-group">
            <label>Correo electrónico</label>
            <input type="email" name="email" maxlength="100" value="@ViewBag.Email" required />
        </div>
        <div class="form-group">
            <label>Teléfono (opcional)</label>
            <input type="text" name="telefono" maxlength="20" value="@ViewBag.Telefono" />
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>Contraseña (mínimo 6 caracteres)</label>
                <input type="password" name="password" minlength="6" required />
            </div>
            <div class="form-group">
                <label>Confirmar contraseña</label>
                <input type="password" name="confirmar" minlength="6" required />
            </div>
        </div>
        <button type="submit" class="btn-action btn-block">Registrarme</button>
        <p class="muted" style="margin-top:12px">¿Ya tienes cuenta? <a asp-action="Ingresar">Inicia sesión</a></p>
    </form>
</div>
