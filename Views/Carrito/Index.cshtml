@model List<PlayerasJyC.Models.CarritoItem>

@{
    ViewData["Title"] = "Mi carrito";
    decimal subtotal = Model.Sum(i => i.Cantidad * i.Variante.Producto.PrecioActual);
}

<div class="page">
    <h2>Mi carrito</h2>

    @if (Model.Count == 0)
    {
        <p class="muted">Tu carrito está vacío.</p>
        <a asp-controller="Productos" asp-action="Index" class="btn-action" style="margin-top:12px">Ir a la colección</a>
    }
    else
    {
        <div class="checkout-grid">
            <div>
                @foreach (var it in Model)
                {
                    var v = it.Variante;
                    <div class="carrito-item">
                        <img src="@v.Producto.Imagen" alt="@v.Producto.Nombre" />
                        <div class="info">
                            <a asp-controller="Productos" asp-action="Detalle" asp-route-id="@v.ProductoId"><b>@v.Producto.Nombre</b></a><br />
                            <small class="muted">Talla @v.Talla.Nombre · @v.Color.Nombre · @v.Stock disponibles</small><br />
                            <span class="card-price" style="font-size:1.1rem">$@v.Producto.PrecioActual.ToString("N2")</span>
                        </div>
                        <form asp-action="Actualizar" asp-route-id="@it.CarritoItemId" method="post" class="acciones">
                            <input type="number" name="cantidad" value="@it.Cantidad" min="0" max="@v.Stock" class="input-neon" />
                            <button type="submit" class="btn-sm">Actualizar</button>
                        </form>
                        <div>
                            <b>$@((it.Cantidad * v.Producto.PrecioActual).ToString("N2"))</b>
                        </div>
                        <form asp-action="Quitar" asp-route-id="@it.CarritoItemId" method="post">
                            <button type="submit" class="btn-sm rojo">Quitar</button>
                        </form>
                    </div>
                }
            </div>

            <div class="resumen-box">
                <h3 style="margin-top:0">Resumen</h3>
                <div class="linea"><span>Piezas</span><span>@(Model.Sum(i => i.Cantidad))</span></div>
                <div class="linea total"><span>Subtotal</span><span>$@subtotal.ToString("N2")</span></div>
                <p class="muted" style="font-size:0.8rem;margin:8px 0">El envío y los cupones se calculan en el siguiente paso.</p>
                <a asp-controller="Checkout" asp-action="Index" class="btn-action btn-block">Continuar con la compra</a>
                <a asp-controller="Productos" asp-action="Index" class="btn-sm gris" style="margin-top:10px">Seguir comprando</a>
            </div>
        </div>
    }
</div>
