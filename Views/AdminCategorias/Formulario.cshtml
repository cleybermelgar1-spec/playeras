@model PlayerasJyC.Models.Categoria

@{
    bool esNuevo = Model.CategoriaId == 0;
    ViewData["Title"] = (esNuevo ? "Nuevo: " : "Editar: ") + "categoría";
}

<div class="page">
    <h2>@(esNuevo ? "Nuevo" : "Editar") categoría</h2>

    <form asp-action="@(esNuevo ? "Crear" : "Editar")" asp-route-id="@Model.CategoriaId" method="post" class="form-card">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-msg err">
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@e.ErrorMessage</div>
                }
            </div>
        }
        <input type="hidden" asp-for="CategoriaId" />
        <div class="form-group">
            <label>Nombre</label>
            <input asp-for="Nombre" maxlength="50" placeholder="" />
        </div>
        <div class="form-group">
            <label>Descripción</label>
            <input asp-for="Descripcion" maxlength="200" placeholder="" />
        </div>
        <div class="form-group form-check">
            <input asp-for="Activo" type="checkbox" /> <label>Activa</label>
        </div>

        <div class="acciones" style="margin-top:14px">
            <button type="submit" class="btn-action">Guardar</button>
            <a asp-action="Index" class="btn-sm gris">Cancelar</a>
        </div>
    </form>
</div>
