@model PlayerasJyC.Models.Usuario

@{
    bool esNuevo = Model.UsuarioId == 0;
    ViewData["Title"] = esNuevo ? "Nuevo usuario" : "Editar usuario";
}

<div class="page">
    <h2>@(esNuevo ? "Nuevo usuario" : "Editar usuario")</h2>

    <form asp-action="@(esNuevo ? "Crear" : "Editar")" asp-route-id="@Model.UsuarioId" method="post" class="form-card">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-msg err">
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@e.ErrorMessage</div>
                }
            </div>
        }
        <input type="hidden" asp-for="UsuarioId" />
        <input type="hidden" asp-for="FechaRegistro" />

        <div class="form-group">
            <label>Nombre</label>
            <input asp-for="Nombre" maxlength="100" />
        </div>
        <div class="form-group">
            <label>Correo electrónico</label>
            <input asp-for="Email" type="email" maxlength="100" />
        </div>
        <div class="form-group">
            <label>Teléfono</label>
            <input asp-for="Telefono" maxlength="20" />
        </div>
        <div class="form-group">
            <label>Rol</label>
            <select name="Rol">
                <option value="Cliente" selected="@(Model.Rol == "Cliente")">Cliente</option>
                <option value="Admin" selected="@(Model.Rol == "Admin")">Administrador</option>
            </select>
        </div>
        <div class="form-group form-check">
            <input asp-for="Activo" type="checkbox" /> <label>Cuenta activa (puede iniciar sesión)</label>
        </div>
        <div class="form-group">
            <label>@(esNuevo ? "Contraseña (mínimo 6 caracteres)" : "Nueva contraseña (vacío = no cambiarla)")</label>
            <input type="password" name="password" />
        </div>

        <div class="acciones" style="margin-top:14px">
            <button type="submit" class="btn-action">Guardar</button>
            <a asp-action="Index" class="btn-sm gris">Cancelar</a>
        </div>
    </form>
</div>
