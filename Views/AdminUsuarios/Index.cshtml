@model List<PlayerasJyC.Models.Usuario>

@{
    ViewData["Title"] = "Admin: Usuarios";
}

<div class="page">
    <div class="toolbar">
        <h2>Usuarios</h2>
        <div class="acciones">
            <a asp-action="Crear" class="btn-sm rosa">+ Nuevo usuario</a>
            <a asp-controller="Admin" asp-action="Index" class="btn-sm gris">Volver al panel</a>
        </div>
    </div>

    <div class="tabla-wrap">
        <table class="tabla">
            <thead><tr><th>Id</th><th>Nombre</th><th>Correo</th><th>Teléfono</th><th>Rol</th><th>Activo</th><th>Registro</th><th></th></tr></thead>
            <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.UsuarioId</td>
                    <td>@u.Nombre</td>
                    <td>@u.Email</td>
                    <td>@u.Telefono</td>
                    <td><span class="estado @(u.Rol == "Admin" ? "Enviado" : "Pagado")">@u.Rol</span></td>
                    <td>@(u.Activo ? "Sí" : "No")</td>
                    <td>@u.FechaRegistro.ToString("dd/MM/yyyy")</td>
                    <td>
                        <div class="acciones">
                            <a asp-action="Editar" asp-route-id="@u.UsuarioId" class="btn-sm">Editar</a>
                            <form asp-action="Eliminar" asp-route-id="@u.UsuarioId" method="post" onsubmit="return confirm('¿Eliminar este usuario?');">
                                <button type="submit" class="btn-sm rojo">Eliminar</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
